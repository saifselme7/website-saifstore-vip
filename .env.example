# Vite environment variables — copy to .env (local) and set them in Vercel
# Project Settings → Environment Variables. Never commit real keys in .env.

# Supabase project URL (Dashboard → Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key (Dashboard → Settings → API → Project API keys)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
